        <!-- Caddy (issue #64) -->
        <mxCell id="27" value="caddy&#xa;docker compose service • caddy:2-alpine&#xa;&#xa;TLS termination — tls internal (on_demand)&#xa;self-signed local CA, persisted in caddy_data&#xa;:443 HTTPS ↔ :80 → redirect to :443&#xa;only container with a host port publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
