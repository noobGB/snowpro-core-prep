        <mxCell id="30" value="server-to-server&#xa;code exchange + tokeninfo verify (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#b85450;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="5" target="27">
