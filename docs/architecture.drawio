        </mxCell>

        <mxCell id="5" value="Express Server&#xa;pipeline/src/server.ts&#xa;&#xa;static frontend + SPA fallback&#xa;/api/session · /api/me · /api/logout&#xa;/api/progress (GET/PUT, ETag+body rev)&#xa;/api/oauth/google/* · /api/password-reset/*&#xa;/api/account/* · /api/admin/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="4">
          <mxGeometry x="60" y="60" width="320" height="200" as="geometry" />
        </mxCell>

        <mxCell id="6" value="Content Pipeline&#xa;runPipeline() at boot&#xa;&#xa;markdown → content.json&#xa;+ notes/*.json + search-index.json&#xa;(regenerated every boot, ephemeral)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="4">
          <mxGeometry x="500" y="60" width="320" height="200" as="geometry" />
