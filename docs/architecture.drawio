        <!-- Internal edge: pipeline output feeds the server -->
        <mxCell id="7" value="content.json / notes / search-index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;dashed=1;" edge="1" parent="4" source="6" target="5">
