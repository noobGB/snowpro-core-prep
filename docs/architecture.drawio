        <!-- Browser -->
        <mxCell id="3" value="Browser&#xa;React 19 SPA (react-router-dom)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="120" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Docker container boundary -->
        <mxCell id="4" value="Docker Container — single image (3-stage build) • serves :8080" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">
