{
  "name": "snowprep-content-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Parses the SnowPro Core Prep markdown study folder into content.json + notes/*.json + search-index.json.",
  "type": "module",
  "scripts": {
    "build:content": "tsx src/index.ts",
    "build:content:watch": "tsx watch src/index.ts",
    "start": "tsx src/server.ts",
    "check:freshness": "node scripts/check-content-freshness.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "mdast-util-to-string": "^4.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "tsx": "^4.19.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
