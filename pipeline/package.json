{
  "name": "snowprep-content-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Parses the SnowPro Core Prep markdown study folder into content.json + notes/*.json + search-index.json.",
  "type": "module",
  "scripts": {
    "build:content": "tsx src/index.ts",
    "build:content:watch": "tsx watch src/index.ts",
    "start": "tsx src/server.ts",
    "check:freshness": "node scripts/check-content-freshness.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "tsx": "^4.19.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
