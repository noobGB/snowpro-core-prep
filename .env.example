# Copy this file to .env (already gitignored) and fill in the placeholders below.
# docker-compose.yml pulls these in automatically since .env sits next to it.
#
# Powers issue #59's forgot-password email — without these set, the app still runs fine, but
# "Forgot password?" responds with a clear "email isn't configured" error instead of sending mail.

# Brevo's free-tier SMTP relay (https://www.brevo.com) — up to ~300 emails/day, and the only
# provider evaluated here that lets you verify a single sender EMAIL ADDRESS rather than a whole
# domain, which matters since this app has no domain of its own. Any other SMTP relay works too —
# these are just the values Brevo happens to use.
SNOWPRO_SMTP_HOST=smtp-relay.brevo.com
SNOWPRO_SMTP_PORT=587
SNOWPRO_SMTP_SECURE=false

# Brevo dashboard -> SMTP & API -> SMTP tab: your SMTP login (an email address) and a generated
# SMTP key (NOT your Brevo account password).
SNOWPRO_SMTP_USER=your-smtp-login@example.com
SNOWPRO_SMTP_PASS=your-generated-smtp-key

# The "From" address on reset emails — must be a sender you've verified in Brevo's dashboard
# (Senders, Domains & Dedicated IPs -> Senders) before Brevo will actually deliver through it.
SNOWPRO_SMTP_FROM=your-verified-sender@example.com

# Optional, and rarely needed. Emailed links (password reset, admin-added-user login link) always
# use the live address you're actually browsing on when you trigger the email — no static config,
# no auto-detected hostname, since real testing found both hostname-based approaches unreliable on
# phones (see CLAUDE.md's "Emailed links always use the live request address" section for why).
# Only set this if you specifically want to force a fixed value instead.
# SNOWPRO_HOST_NAME=your-custom-hostname
