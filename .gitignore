# Dependencies
node_modules/

# Build output
app/dist/
pipeline/dist/

# Generated by the content pipeline — a build artifact (spec §9 treats it like /app/dist),
# regenerated from the markdown source folder at container start, not source-controlled.
content/

# The app's own progress volume (spec §9) once you run the container — an operator's personal
# quiz progress, never source-controlled, same reasoning as content/ above.
data/

# Design-tool artifacts: a stale duplicate of the markdown source plus the copyrighted
# Snowflake study guide PDF — spec §8 explicitly flags the PDF as not for the repo.
uploads/
.thumbnail

# More design-tool internals: doc-page.js/support.js are the wireframe-preview tool's own
# rendering runtime (support.js says so itself: "GENERATED from dc-runtime/src/*.ts — do not
# edit"), and _ds/ is a whole alternate ("Classical") design system that was attached to the
# project but never adopted — the spec's own text confirms the dark theme was used instead. None
# of this is app code or needed to build/run/understand the app; the *.dc.html wireframes and the
# spec itself stay tracked since those genuinely document what the app was built from.
doc-page.js
support.js
_ds/

# The official Snowflake study guide PDF, kept locally in SnowPro_Notes_and_Questions/ for your
# own reference — copyrighted, not Snowflake's to redistribute, explicitly excluded from the repo
# (see that folder's own CLAUDE.md). Everything else in that folder is original content and stays
# tracked.
SnowPro_Notes_and_Questions/*.pdf

# OS / editor
.DS_Store
Thumbs.db
*.log

# Local env overrides
.env
.env.local
